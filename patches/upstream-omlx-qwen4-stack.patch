+_ENV_PLAN = "OMLX_M5_GATHER_QMM_NAX_PLAN"
+_ENV_SWIGLU = "OMLX_M5_GATHER_QMM_NAX_SWIGLU"
+_ENV_ROW_MAP = "OMLX_M5_GATHER_QMM_NAX_ROW_MAP"
