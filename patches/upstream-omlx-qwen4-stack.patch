+    verifier = Qwen3_5BatchInvariantForward
+    monkeypatch.setattr(verifier, "_switch_glu", verifier._switch_glu)
+    saved = {cls: cls.__dict__.get("__call__") for cls in (SwitchGLU, VLMSwitchGLU)}
