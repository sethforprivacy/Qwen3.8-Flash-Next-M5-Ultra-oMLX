+    got = reroute.fused_gate_up_activation(
+        proj, x, idx, SwiGLU(), token_rows=(x_tok, row_map)
+    )
+    # declined map -> the copy (earlier launches: the unmapped canaries,
+    # re-run after the verdict cache reset)
