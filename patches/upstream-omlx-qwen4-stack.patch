+    constexpr int TB = {tb};
+    constexpr int DB = {_PIPE_DB};
+    constexpr int NT = {_PIPE_THREADS};
+    const int tid = thread_position_in_threadgroup.x;
+    const int hv = threadgroup_position_in_grid.y;
+    const int b = threadgroup_position_in_grid.z;
