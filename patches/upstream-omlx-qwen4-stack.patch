+    def expand(rel: str) -> str:
+        path = root / rel
+        if path in seen:
+            return ""
+        seen.add(path)
+        lines = []
+        for line in path.read_text().splitlines():
+            stripped = line.strip()
+            if stripped.startswith('#include "mlx/') and stripped.endswith('"'):
+                lines.append(expand(stripped[len('#include "') : -1]))
