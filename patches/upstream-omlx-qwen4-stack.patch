+        for inverse_scatter in (False, True):
+            glu.inverse_scatter = inverse_scatter
+            for weighted in (False, True):
+                _check_on_off(
+                    lambda: glu(x, inds, scores=scores, weighted_sum=weighted),
+                    launches,
+                    monkeypatch,
+                )
+
