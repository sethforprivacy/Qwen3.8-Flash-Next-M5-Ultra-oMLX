+        grid=(_PIPE_THREADS * (Dv // _PIPE_DB), Hv, B),
+        threadgroup=(_PIPE_THREADS, 1, 1),
+        output_shapes=[(B, T, Hv, Dv), (B, Hv, Dv, Dk)],
+        output_dtypes=[in_dtype, mx.float32],
+    )
