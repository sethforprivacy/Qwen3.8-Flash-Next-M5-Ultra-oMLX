+    assert nax._plan(10240, 512, 2560, 1280) == P(SEG, 96, 64, 4, 0)
+    for bad in ("seg,80,64,0,0", "db,64,256,0,0", "xx,64,64,0,0", "seg,64,64", "seg,64,64,0,99999"):
